{
  "name": "@internal/figma-sdk",
  "version": "1.0.0",
  "description": "Every figma-api workspace package in one install — namespaced re-exports plus one subpath per package. Install a single package (e.g. @internal/figma-comments) to take only that one.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./comments": {
      "types": "./dist/comments.d.ts",
      "import": "./dist/comments.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js"
    },
    "./dev-resources": {
      "types": "./dist/dev-resources.d.ts",
      "import": "./dist/dev-resources.js"
    },
    "./figma-fetch": {
      "types": "./dist/figma-fetch.d.ts",
      "import": "./dist/figma-fetch.js"
    },
    "./figma-fetch-file": {
      "types": "./dist/figma-fetch-file.d.ts",
      "import": "./dist/figma-fetch-file.js"
    },
    "./files": {
      "types": "./dist/files.d.ts",
      "import": "./dist/files.js"
    },
    "./library-analytics": {
      "types": "./dist/library-analytics.d.ts",
      "import": "./dist/library-analytics.js"
    },
    "./projects": {
      "types": "./dist/projects.d.ts",
      "import": "./dist/projects.js"
    },
    "./variables": {
      "types": "./dist/variables.d.ts",
      "import": "./dist/variables.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist *.tsbuildinfo",
    "build": "npm run clean && node scripts/gen-version.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules ../node_modules/.bin/jest",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "figma",
    "api",
    "sdk",
    "umbrella",
    "client",
    "typescript"
  ],
  "author": "thinkeloquent",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@internal/figma-api-fetch": "^1.0.0",
    "@internal/figma-api-fetch-file": "^1.0.0",
    "@internal/figma-comments": "^1.0.0",
    "@internal/figma-components-api": "^1.0.0",
    "@internal/figma-dev-resources": "^1.0.0",
    "@internal/figma-files-api": "^1.0.0",
    "@internal/figma-library-analytics": "^1.0.0",
    "@internal/figma-projects": "^1.0.0",
    "@internal/figma-variables-sdk": "^1.0.0",
    "@internal/figma-webhooks": "^1.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "typescript": "^5.0.0"
  }
}
